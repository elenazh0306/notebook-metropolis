<!-- Turbo Frame ID dynamically *matches* the receiver ID in app/views/categories/index.html.erb -->
<% frame_id = @note.hotspot_type == "street" ? "note_content_#{@note.id}" : "room_hotspot_content" %>

<turbo-frame id="<%= frame_id %>">
  <% laptop_view = @note.hotspot_type == "laptop" %>
  <% posters_view = @note.hotspot_type == "posters" %>

  <% if laptop_view %>
    <div class = "hackercat-laptop-view">
      <div class = "hackercat-laptop-shell">
        <%= image_tag "hackercat-laptop-frame.png", class: "hackercat-laptop-image", alt: "Hackercat Laptop" %>
        <div class = "hackercat-laptop-screen">
  <% elsif posters_view %>
    <div class = "posters-view">
      <div class = "posters-shell">
        <%= image_tag "cozy-study-posters-frame.png", class: "cozy-study-posters-image", alt: "Cozy Study Posters" %>
        <div class = "posters-wall">
  <% end %>
  <!-- The container from notes/index.html.erb, ensuring the note overlays perfectly -->
  <div class = "<%= if laptop_view then 'laptop-container' elsif posters_view then 'posters-container' else 'corkboard-container' end %> p-3">
    <div class="<%= 'posters-form-header' if posters_view %> d-flex justify-content-between align-items-center mb-3">
      <h5 class="m-0">
        <%= case @note.hotspot_type
              when "bookcase" then "📖 Edit a Book Note"
              when "laptop" then "💻 Edit a Coding Note"
              when "posters" then "🖼️ Edit a Picture Note"
              when "street" then "🖼️ Edit a Note"
              else "📌 Edit a Post-it Note"
            end %>
      </h5>
      <!-- Cancel button just in case we regret our edits -->
      <% if @note.hotspot_type == "street" %>
        <%= link_to "Cancel", categories_path,
                  class: "btn btn-outline-secondary btn-sm" %>
      <% else %>
        <%= link_to "Cancel", category_note_path(@category, @note),
                    data: { turbo_frame: "room_hotspot_content" }, # hello ID from app/views/categories/index.html.erb
                    class: "btn btn-outline-secondary btn-sm" %>
      <% end %>
    </div>

    <!-- Pre-filled Form Container -->
    <% if @note.hotspot_type == "street" %>
      <div class="card border-0 shadow-sm p-3 style-postit-detail">
        <%= form_with(model: [@category, @note],
                      data: { turbo_frame: "_top" }) do |f| %>
          <div class="mb-3">
            <%= f.label :category_id, "Category", class: "form-label fw-bold text-dark" %>
            <%= f.collection_select :category_id,
                              Category.all,
                              :id,
                              :name,
                              { selected: @category.id },
                              { class: "form-select", required: true } %>
          </div>
          <div class="mb-3">
          <%= f.label :hotspot_type, "Pick where to pin", class: "form-label fw-bold text-dark" %>

          <%= f.select :hotspot_type,
                ["bookcase", "laptop", "posters", "notice_board"],
                { prompt: "Select a spot" },
                { class: "form-select", required: true } %>
          </div>
          <div class="mb-3">
            <%= f.label :title,
                        (case @note.hotspot_type
                          when "bookcase" then "Book Title"
                          when "laptop" then "Project Title"
                          when "posters" then "Poster Title"
                          else "Post-It Title"
                        end),
                        class: "form-label fw-bold text-dark" %>
            <%= f.text_field :title,
                            class: "form-control",
                            required: true %>
          </div>

          <div class="mb-3">
            <%= f.label :content, "Note Details", class: "form-label fw-bold text-dark" %>
            <%= f.text_area :content,
                            rows: 4,
                            class: "form-control",
                            required: true %>
          </div>

          <div class="d-grid">
            <%= f.submit "💾 Save Changes", class: "btn btn-dark fw-bold" %>
          </div>

        <% end %>
      </div>
    <% else %>
      <div class = "<%= if laptop_view then 'laptop-note-form' elsif posters_view then 'posters-note-form' else 'card border-0 shadow-sm p-3 style-postit-detail' end %>">
        <%= form_with(model: [@category, @note],
                      data: { turbo_frame: "room_hotspot_content" }) do |f| %> <!-- once again, the ID from app/views/categories/index.html.erb -->

          <!-- Preserves which hotspot_type this note belongs to -->
          <%= f.hidden_field :hotspot_type %>

          <div class="mb-3">
            <%= f.label :title,
                        (case @note.hotspot_type
                          when "bookcase" then "Book Title"
                          when "laptop" then "Project Title"
                          when "posters" then "Poster Title"
                          else "Post-It Title"
                        end),
                        class: "form-label fw-bold text-dark" %>
            <%= f.text_field :title,
                            class: "form-control",
                            required: true %>
          </div>

          <div class="mb-3">
            <%= f.label :content, "Note Details", class: "form-label fw-bold text-dark" %>
            <%= f.text_area :content,
                            rows: 4,
                            class: "form-control",
                            required: true %>
          </div>

          <% if posters_view %>
            <div class = "mb-3">
              <%= f.label :image, "Replace Image", class: "form-label fw-bold text-dark" %>
              <%= f.file_field :image, accept: "image/png, image/jpeg", class: "form-control" %>
            </div>
          <% end %>

          <% if laptop_view %>
            <div class="d-grid">
              <%= f.button type: "submit", class: "btn btn-info btn-sm shadow-sm text-dark" do %>
                💾 Save Changes
              <% end %>
            </div>
          <% elsif posters_view %>
            <div class = "posters-submit">
              <%= f.button type: "submit", class: "btn posters-action-btn" do %>
                💾 Save Changes
              <% end %>
            </div>
          <% else %>
            <div class = "d-grid">
              <%= f.submit "💾 Save Changes", class: "btn btn-dark fw-bold" %>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
<% if laptop_view %>
      </div>
    </div>
  </div>
<% elsif posters_view %>
      </div>
    </div>
  </div>
<% end %>
</turbo-frame>
