<!-- Turbo Frame ID *matches* the receiver ID in app/views/categories/index.html.erb -->
<turbo-frame id="room_hotspot_content">
  <% laptop_view = @note.hotspot_type == "laptop" %>
  <% posters_view = @note.hotspot_type == "posters" %>
  <% book_view = @note.hotspot_type == "bookcase" %>

  <% if laptop_view %>
    <div class = "hackercat-laptop-view">
      <div class = "hackercat-laptop-shell">
        <%= image_tag "hackercat-laptop-frame.png", class: "hackercat-laptop-image", alt: "Hackercat Laptop" %>
        <div class = "hackercat-laptop-screen">
  <% elsif posters_view %>
    <div class = "posters-view">
      <div class = "posters-shell">
        <%= image_tag "cozy-study-posters-frame.png", class: "cozy-study-posters-image", alt: "Cozy Study Posters" %>
        <div class = "posters-wall">
  <% elsif book_view %>
    <div class = "book-view">
      <div class = "book-shell">
        <%= image_tag "gothic-library-book-frame.png", class: "book-image", alt: "Gothic Library Book" %>
        <%= image_tag "gothic-library-pen.png", class: "pen-image", alt: "Gothic Library Pen" %>
          <div class = "book-page">
  <% end %>

  <div class = "<%= if laptop_view then 'laptop-container' elsif posters_view then 'posters-container' elsif book_view then 'book-container' else 'corkboard-container' end %> p-3">
    <div class="<%= if posters_view then 'posters-form-header' elsif book_view then 'book-form-header' end %> d-flex justify-content-between align-items-center mb-3">
      <h5 class="m-0">
        <%= case @note.hotspot_type
              when "bookcase" then "📖 Write a Book Note"
              when "laptop" then "💻 Write a Coding Note"
              when "posters" then "🖼️ Write a Picture Note"
              else "📌 Write a Post-it Note"
            end %>
      </h5>

      <!-- Cancel button just in case we change our minds -->
      <%= link_to "Cancel", category_notes_path(@category, hotspot_type: @note.hotspot_type), # If the user doesn't want to save the new note
                  data: { turbo_frame: "room_hotspot_content" },
                  class: (posters_view ? 'btn posters-cancel-btn' : 'btn btn-outline-secondary btn-sm') %>
    </div>

    <!-- Here with make the new note with a styled Form Container -->
    <div class="<%= if laptop_view then 'laptop-note-form' elsif posters_view then 'posters-note-form' elsif book_view then 'book-note-form' else 'card border-0 shadow-sm p-3 style-postit-detail' end %>">
      <%= form_with(model: [@category, @note],
                    data: { turbo_frame: "room_hotspot_content" }) do |f| %> <!-- Turbo Frame ID links to app/views/categories/index.html.erb -->

        <!-- Hidden Field: Ensures the note is saved into the correct hotspot_type
        The user doesn't give the note a hotspot_type, this happens automatically - if they save
        the note on the notice board, that is the hotspot_type, if they save it in the bookshelf,
        that is the hotspot_type -->
        <%= f.hidden_field :hotspot_type %>

        <div class="mb-3">
          <!-- I am not a super fan of all these hard-coded case-staments,
          but what alternative? Also, how cool is it that you can used case
          statements inside a form? -->
          <%= f.label :title,
                      (case @note.hotspot_type
                        when "bookcase" then "Book Title"
                        when "laptop" then "Project Title"
                        when "posters" then "Poster Title"
                        else "Post-It Title"
                      end),
                      class: "form-label fw-bold text-dark" %>

          <%= f.text_field :title,
                          class: "form-control",
                          placeholder: (case @note.hotspot_type
                                          when "bookcase" then "Neuromancer"
                                          when "laptop" then "Today's Coding Documentation"
                                          when "posters" then "Cyberpunk City Map"
                                          else "Remember to feed the cat"
                                        end),
                          required: true %>
        </div>

        <div class="mb-3">
          <%= f.label :content, "Note Details", class: "form-label fw-bold text-dark" %>
          <%= f.text_area :content,
                          rows: 4,
                          class: "form-control",
                          placeholder: "Write your thoughts or tasks here...",
                          required: true %>
        </div>

        <% if @note.hotspot_type =="posters" %>
          <div class = "mb-3">
            <%= f.label :image, "Upload Image", class: "form-label fw-bold text-dark" %>
            <%= f.file_field :image, accept: "image/png, image/jpeg", class: "form-control" %>
          </div>
        <% end %>

        <% if laptop_view %>
          <div class="d-grid">
            <%= f.button type: "submit", class: "btn btn-info btn-sm fw-bold shadow-sm text-dark" do %>
              💻 Save to Drive
            <% end %>
          </div>
        <% elsif posters_view %>
          <div class = "posters-submit">
            <%= f.button type: "submit", class: "btn posters-action-btn" do %>
              🖼️ Hang Poster
            <% end %>
          </div>
        <% elsif book_view %>
          <div class = "book-submit">
            <%= f.button type: "sbumit", class: "btn book-save-btn" do %>
              📖 Add to Library
            <% end %>
          </div>
        <% else %>
          <div class="d-grid">
            <%= f.submit "📌 Pin to Board", class: "btn btn-dark fw-bold" %>
          </div>
        <% end %>
      <% end %>
    </div>

  </div>
<% if laptop_view %>
      </div>
    </div>
  </div>
<% elsif posters_view %>
      </div>
    </div>
  </div>
<% elsif book_view %>
      </div>
    </div>
  </div>
<% end %>
</turbo-frame>
