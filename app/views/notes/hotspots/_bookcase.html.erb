<div class="bookcase-container p-3">
  <!-- Header with Category Title & New Book Button -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="m-0">📚 <%= @category.name %> Bookcase</h4>

    <!-- New Bookcase Note Link (passes hotspot_type: "bookcase") -->
    <%= link_to new_category_note_path(@category, hotspot_type: "bookcase"),
                data: { turbo_frame: "room_hotspot_content" }, # linking to the correct id!
                class: "btn btn-warning btn-sm fw-bold shadow-sm" do %>
      📖 + Add Book Note
    <% end %>
  </div>

  <% if @notes.any? %>
    <div class="bookshelf-row">
      <% @notes.each do |note| %>
        <%= link_to category_note_path(@category, note),
                    data: { turbo_frame: "room_hotspot_content" },
                    class: "book-spine-link" do %>
          <div class="book-spine">
            <span class="book-title"><%= note.title %></span>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-5">
      <p class="text-muted">No books on this shelf yet!</p>
    </div>
  <% end %>
</div>
