<% citizen = Citizen.find_or_create_by!(category_id: @category.id) { |c| c.name = Citizen::DEFAULT_NAME } %>
<%= turbo_stream_from citizen %>

<div class="ai-assistant-container p-3">

  <!-- Header with Category (Room) Title & Status Badge -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="m-0 fw-bold">🐱 <%= @category.name %> AI Companion</h4>
    <!-- This span is purely decorative and balances the top part of the
    chat modal. Later, if we want, we can change its text to 'cogitating'
    and make it hum or glow while the AI thinks of its response -->
    <span class="badge bg-success shadow-sm px-3 py-2">Online</span>
    <div id = "ai-note-save-notification-<%= @category.id %>"></div>
  </div>

  <!-- THE CHAT CONTAINER STARTS HERE -->
  <!-- This div holds the conversation. It also makes a scroll bar appear
  if the chat gets too long -->
  <div class="border rounded-3 p-3 bg-light shadow-inner mb-3" style="height: 350px; overflow-y: auto; visibility: hidden;" data-controller = "chat-scroll">

    <!-- THIS IS THE CONTAINER WHERE THE CHAT LOG RUNS -->
    <div class="d-flex flex-column gap-3">

      <!-- AI Message Bubble (The AI's responses are posted here) -->
      <div class="d-flex align-items-start gap-2">
        <div class="bg-primary text-white p-3 rounded-3 shadow-sm max-w-75">
          <small class="fw-bold d-block mb-1 text-white-50">🐱 Room AI</small>
          Hello! I am your AI assistant for <strong><%= @category.name %></strong>. How can I help you organize or analyze your notes today?
        </div>
      </div>

      <!-- Dynamic chat messages will be appended inside THIS div (.chat-field) via Turbo Stream -->
      <!-- Don't worry about the Turbo Stream part: I will help you with that -->

      <div id = "chat-field-<%= citizen.id %>" class = "chat-field d-flex flex-column gap-3">
        <% if citizen.present? %>
          <% citizen.messages.order(:created_at).each do |message| %>
            <%= render "messages/message", message: message %>
          <% end %>
        <% end %>
      </div>
        <!--
          When you set up the backend (or when Turbo Stream appends new messages),
          this empty div serves as the ANCHOR TARGET (class="chat-field").

          Whenever a user hits "Send", Rails will render a new speech bubble
          (just like the ones above) and insert it inside this .chat-field container.
        -->
    </div>
  </div>

  <!-- THIS IS WHERE YOU RESPOND IN THE CHAT -->
  <div id = "new-message-container">
    <!-- Replace 'url: "#"' with your actual LLM Messages controller path -->
    <%= render "messages/form", citizen: citizen, message: Message.new %>
  </div>
</div>

<!-- PS: We don't need to include a "back to room" button,
because the bootstrap modal automatically includes a
"close this window"-button -->
