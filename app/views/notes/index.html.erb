<!-- Friendly reminder to myself : Turbo Frame ID *must* match the receiver ID in _room_modal.html.erb -->
<turbo-frame id="notice_board_content">
  <div class="corkboard-container p-3">

    <!-- A nice notice header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h4 class="m-0">📌 <%= @category.name %> Notes</h4>
    </div>

    <% if @notes.any? %>
      <div class="postit-grid">
        <% @notes.each do |note| %>

          <!-- 1. Individual Note Card, including a link to that note -->
          <%= link_to category_note_path(@category, note),
                      data: { turbo_frame: "notice_board_content" }, #links to the ID on categories/index.html.erb
                      class: "postit-card-link" do %>
            <div class="postit-card">
              <span class="pin">📍</span>
              <h6 class="postit-title"><%= note.title %></h6>
            </div>
          <% end %>

        <% end %>
      </div>
    <% else %>
      <div class="text-center py-5">
        <p class="text-muted">You have no notes on this board yet!</p>
      </div>
    <% end %>

  </div>
</turbo-frame>
