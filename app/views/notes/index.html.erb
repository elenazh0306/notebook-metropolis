<!-- Friendly reminder to myself: Turbo Frame ID *must* match the receiver ID in app/views/categories/index.html.erb -->
<turbo-frame id="room_hotspot_content">

  <% if @subfolder == "bookcase" %>
    <%= render "notes/bookcase" %>
  <% else %>
    <%= render "notes/notice_board" %>
  <% end %>

</turbo-frame>
