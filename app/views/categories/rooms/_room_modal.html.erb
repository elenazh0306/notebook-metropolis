<div class="modal fade room-modal"
    id="categoryModal_<%= category.id %>"
    tabindex="-1"
    aria-hidden="true">
  <div class="modal-dialog modal-xl">
    <div class="modal-content">

      <!-- Modal Header -->
      <div class="modal-header room-header position-relative">
        <div class="w-100 d-flex justify-content-center align-items-center gap-2">
          <span class="room-status-dot"></span>
          <h5 class="modal-title room-title"><%= File.basename(category.room_image.to_s, '.*') %></h5>
        </div>
        <button type="button" class="btn-close btn-close-white position-absolute end-0 me-3" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <!-- Modal Body -->
      <div class="modal-body">
        <!-- We attach the Stimulus Controller for Room to the container -->
        <!-- We use a room category slug for CSS scoping (e.g., room-cozy-study or gothic-library) -->
        <div class="room-container room-<%= File.basename(category.room_image.to_s, '.*').parameterize %>"
          id="roomContainer_<%= category.id %>"
          data-controller="room">

          <!-- Animated Room Video -->
          <!-- We add Stimulus 'target' and 'action' to the video -->
          <%= video_tag category.intro_video,
                  autoplay: true,
                  muted: true,
                  playsinline: true,
                  class: "room-intro-video",
                  data: {
                    room_target: "video",
                    action: "ended->room#transition"
                  } %>

          <!-- We add Stimulus 'target' to the interactive layer -->
          <div class="room-interactive-layer room-hidden"
            data-room-target="interactiveLayer">

            <!-- All Hotspot links within a Room are dynamically rendered based on Category Name -->
            <%= render partial: "categories/rooms/hotspots/#{File.basename(category.room_image.to_s, '.*').parameterize.underscore}", locals: { category: category } %>

          </div>
        </div>
      </div>

    </div>
  </div>
</div>
