<!-- Hackercat Room Hotspots Overlay -->

<!-- Notice Board Hotspot -->
<%= link_to category_notes_path(category, hotspot_type: "notice_board"),
            data: { turbo_frame: "room_hotspot_content" },
            onclick: "bootstrap.Modal.getOrCreateInstance(document.getElementById('roomHotspotModal')).show()",
            class: "mural hotspot-cyber-noticeboard" do %>
  <span class="hotspot-label">Cyber Notice Board</span>
<% end %>

