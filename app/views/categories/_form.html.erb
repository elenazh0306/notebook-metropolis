<div class = "new-category-menu">
  <button
    class = "btn btn-primary"
    type = "button"
    data-bs-toggle = "offcanvas"
    data-bs-target = "#new-category-menu"
    aria-expanded = "false"
    aria-controls = "new-category-menu"
  >Create New Building</button>
  <div class = "offcanvas offcanvas-end" style = "width: 25vw" id = "new-category-menu">
    <div class = "offcanvas-header">
      <h3>Create a New Building</h3>
      <button
      type = "button"
      class = "btn-close"
      data-bs-dismiss = "offcanvas"
      aria-label = "Close"
      ></button>
    </div>
    <div class = "offcanvas-body">
      <%= simple_form_for Category.new do |f| %>
        <%= f.input :name, label: "Building Name", placeholder: "Enter a building name" %>
        <!--Building selector to be added here later.-->
        <%= f.button :submit, "Create Building", class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>
</div>
