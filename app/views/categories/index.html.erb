<% if mobile_app? %>
  <%= render "layouts/mobile_index" %>
<% else %>
  <%= render "shared/navbar" %>

  <div class = "map-container">
    <!--Search Results-->
    <% if @query.present? %>
      <div class = "search-result">
        <div class = "d-flex justify-content-between align-items-center mb-3">
          <h5>
            Search results for "<%= @query %>"
          </h5>
          <%= link_to "×", categories_path, class: "search-close" %>
        </div>
        <% if @search_results.present? %>
          <% @search_results.each do |note| %>
            <div class = "card mb-4">
              <div class = "card-body">
                <small class = "text-muted">
                  <%= note.category.name %>
                </small>
                <h5 class = "card-title mt-1">
                  <%= note.title %>
                </h5>

                <p class = "card-text">
                  <%= truncate(strip_tags(note.content.to_s), length: 150) %>
                </p>

                <%= link_to("Open Note", category_note_path(note.category, note),
                            data: {turbo_frame: "room_hotspot_content"}, onclick: "
                            const roomElement = document.getElementById('categoryModal_#{note.category.id}');
                            const roomModal = bootstrap.Modal.getOrCreateInstance(roomElement);

                            roomElement.addEventListener('shown.bs.modal', function () {
                              bootstrap.Modal.getOrCreateInstance(document.getElementById('roomHotspotModal')).show();}, {once:true}); roomModal.show();", class: "btn btn-sm btn-outline-primary") %>
              </div>
            </div>
        <% end %>
      <% else %>
        <p class = "text-muted">
          No matches found.
        </p>
      <% end %>
    </div>
  <% end %>
  </div>
  <div id="trash_notes_content">
  </div>

  <div  class = "city-board-container" data-controller="board" data-board-editing-value="false">
      <div class = "map-actions">
        <button type="button"
          class="map-edit-button"
          data-board-target="editBtn"
          data-action="click->board#edit">
          🔨 Renovate the City
        </button>

        <button type="button"
          class="map-save-button"
          data-board-target="saveBtn"
          data-action="click->board#save">
          ✅ Approve Changes
        </button>
      </div>
      <div class="board" >
        <% @row.times do |y| %>
          <div class="d-flex">
            <% @column.times do |x| %>
              <%= render "tile_maps/tile", x: x, y: y, tile_map: current_user.tile_map %>
            <% end %>
          </div>
        <% end %>
      </div>
  </div>


  <div class = "new-category-menu">
    <div class = "offcanvas offcanvas-end" id = "new-category-menu" >
      <div class = "offcanvas-header">
        <h3>Create a New Building</h3>
          <button
            type = "button"
            class = "btn-close"
            data-bs-dismiss = "offcanvas"
            aria-label = "Close">
          </button>
      </div>
      <div class = "offcanvas-body" id="category_new_form">
        <%= render "form", category: @category %>
      </div>
    </div>
  </div>

  <!-- Render the Modal Partial for this Category -->
  <!-- '.select(&:persisted?)' is a guard clause that ensures unsaved objects don't crash the loop -->
  <% @categories.select(&:persisted?).each do |category| %>
    <% if category.name != "trash" %>
      <%= render "categories/rooms/room_modal", category: category %>
    <% else %>
      <%= render "note_modal", category: category, note: category.notes[0] %>
    <% end %>
  <% end %>

  <!-- A Resuable Modal for all Notes 'Bookcases, Notice Boards, Laptops, etc.' -->
  <div class="modal fade" id="roomHotspotModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content notice-board-background">
        <div class="modal-header">
          <h5 class="modal-title">Notebook Metropolis</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body">
          <!-- Static Frame ID that receives all hotspot content -->
          <turbo-frame id="room_hotspot_content">
            <p class="text-center text-muted my-4">Loading notes in hotspot...</p>
          </turbo-frame>
        </div>
      </div>
    </div>
  </div>
<% end %>
