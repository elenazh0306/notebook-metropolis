<% current_type = tile_map[y][x].to_s %>
<% tile = User::TILE_TYPES[current_type.to_sym] %>
<% tile_order = User::TILE_TYPES.keys.map(&:to_s) %>
<% category_on_tile = @categories.find { |c| c.x == x && c.y == y } %>

<div id="tile_<%= x %>_<%= y %>"
      class="tile"
      data-controller="tile"
      data-tile-x-value="<%= x %>"
      data-tile-y-value="<%= y %>"
      data-tile-current-value="<%= current_type %>"
      data-tile-types-value="<%= tile_order.to_json %>"
      data-action="click->tile#cycleForward">
  <%= tile[:name] %>

  <% case tile[:name] %>
    <% when 'base' %>

      <% if category_on_tile %>
        <!-- The Building Sprite and the Modal Trigger -->
        <!-- We make the modal target dynamic, based on the category id -->
        <button type="button"
          class="building-btn"
          data-bs-toggle="modal"
          data-bs-target="#categoryModal_<%= category_on_tile.id %>">
          <% image_name = category_on_tile.sprite_image.presence || "default.png" %>
          <%= image_tag image_name, class: "sprite-image", alt: category_on_tile.name %>
          <%= category_on_tile.name %>
        </button>

      <% else %>
        <!-- No building yet: We show the '+' build-link -->
        <%= link_to "+", new_category_path(x: x, y: y), class: "add-btn", title: "Build here" %>
      <% end %>

    <% when 'path' %>
      <span class="tile-symbol">🛣️</span>

    <% when 'grass' %>
      <span class="tile-symbol">🌱</span>

    <% else %>
      <span class="tile-symbol">❓</span>
  <% end %>

</div>
