<%
  current_type = current_user.tile_map[y][x].to_s
  tile = User::TILE_TYPES[current_type.to_sym] || { name: 'unknown' }
  tile_order = User::TILE_TYPES.keys.map(&:to_s)
  category_on_tile = current_user.categories.find { |c| c.x == x && c.y == y }
  building_data = category_on_tile ? User::BUILDINGS.find { |b| b[:url] == category_on_tile.building_sprite } : nil
  extra_class = building_data&.fetch(:css_class, "") || ""
%>

<div id="tile_<%= x %>_<%= y %>"
      class="<%= tile[:name] %>"
      draggable="true"
      data-controller="tile swap"
      data-swap-x-value="<%= x %>"
      data-swap-y-value="<%= y %>"
      data-swap-icon-value="<%= asset_path('trashIcon.ico')%>"

      data-action="dragstart->swap#dragStart
                  dragover->swap#dragOver
                  dragleave->swap#dragLeave
                  drop->swap#drop"

      data-tile-x-value="<%= x %>"
      data-tile-y-value="<%= y %>"
      data-tile-current-value="<%= current_type %>"
      data-tile-types-value="<%= tile_order.to_json %>"
  >

    <% if !category_on_tile %>

      <div>
        <select data-board-target="tileDropdown"
                data-action="change->tile#selectType"
                class="tile-dropdown">
          <% User::TILE_TYPES.each do |key, data| %>
            <option value="<%= key %>" <%= 'selected' if key.to_s == current_type %>>
              <%= data[:name].titleize %>
            </option>
          <% end %>
        </select>
      </div>

    <% end %>

    <% if category_on_tile %>
      <!-- The Building Sprite and the Modal Trigger -->
      <!-- We make the modal target dynamic, based on the category id -->
      <% if category_on_tile.name != 'trash' %>
        <div>
          <%= image_tag "buildings/#{category_on_tile.building_sprite}", class: "house-tile #{extra_class}".strip, alt: category_on_tile.name %>
          <div class="house-name"> <%= category_on_tile.name %></div>
        </div>


          <button type="button"
                  class="building-view-btn"
                  data-bs-toggle="modal"
                  data-bs-target="#categoryModal_<%= category_on_tile.id %>">
                    <div> Visit house 🗝️</div>
                  </button>


      <% else %>
          <% note = category_on_tile.notes[0] %>
          <div>
              <%= image_tag "buildings/#{category_on_tile.building_sprite}", class: "house-tile trash-tile #{extra_class}".strip, alt: category_on_tile.name %>
          </div>

            <button type="button"
                    class="trash-view-btn"
                    data-bs-toggle="modal"
                    data-bs-target="#noteModal_<%= note&.id %>">
                      <div> Recycle trash </div>
                    </button>


      <% end %>

            <%= button_to category_path(category_on_tile),
            method: :delete,
            data: { turbo_confirm: "Are you sure you want to demolish this building?"},
            class: "btn  btn-sm btn-delete" do %>
              <i class="fa-solid fa-x"></i>
              <% end %>


    <% elsif tile[:buildable] %>
      <!-- Tile is buildable but empty: Show '+' build button -->
      <button type="button"
            class="building-btn"
            data-bs-toggle="offcanvas"
            data-bs-target="#new-category-menu"
            data-action="click->tile#buildForm"
            data-tile-x-param="<%= x %>"
            data-tile-y-param="<%= y %>"
            title="Build here">
      <i class="fa-solid fa-house"></i>
      </button>
    <% end %>
</div>
