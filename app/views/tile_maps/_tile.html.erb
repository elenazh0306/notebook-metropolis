<%
  current_type = current_user.tile_map[y][x].to_s
  tile = User::TILE_TYPES[current_type.to_sym] || { name: 'unknown' }
  tile_order = User::TILE_TYPES.keys.map(&:to_s)
  category_on_tile = current_user.categories.find { |c| c.x == x && c.y == y }
%>

<div id="tile_<%= x %>_<%= y %>"
      class="muuri-item <%= tile[:name] %>"
      data-tile-x-value="<%= x %>"
      data-tile-y-value="<%= y %>"
      data-tile-current-value="<%= current_type %>"
      data-tile-types-value="<%= tile_order.to_json %>">

  <div class="muuri-item-content">
    <% if !category_on_tile %>

    <div data-drag-drop-target='empty'>
      <select data-board-target="tileDropdown"
              data-action="change->tile#selectType"
              class="tile-dropdown">
        <% User::TILE_TYPES.each do |key, data| %>
          <option value="<%= key %>" <%= 'selected' if key.to_s == current_type %>>
            <%= data[:name].titleize %>
          </option>
        <% end %>
      </select>
      </div>

    <% else %>
        <div
          class='draggable'
          draggable="true"
          data-drag-drop-target='trash'
          data-category-id="<%= category_on_tile.id %>"
          data-category-x="<%= category_on_tile.x %>"
          data-category-y="<%= category_on_tile.y %>">
          <%= image_tag category_on_tile.building_sprite, class: "house-tile", alt: category_on_tile.name %>
          <div class="house-name"> <%= category_on_tile.name %></div>
        </div>


    <% end %>

    <% if category_on_tile %>
      <!-- The Building Sprite and the Modal Trigger -->
      <!-- We make the modal target dynamic, based on the category id -->
      <% if category_on_tile.name != 'trash' %>
        <div>
          <%= image_tag category_on_tile.building_sprite, class: "house-tile", alt: category_on_tile.name %>
          <div class="house-name"> <%= category_on_tile.name %></div>
        </div>
        <div class='btn-container'>
              <div>
                <button type="button"
                        class="building-btn"
                        data-bs-toggle="modal"
                        data-bs-target="#categoryModal_<%= category_on_tile.id %>">
                          <div> Visit house 🗝️</div>
                        </button>
              </div>
        </div>
      <% else %>
          <div
            class='draggable'
            data-category-id="<%= category_on_tile.id %>"
            data-category-x="<%= category_on_tile.x %>"
            data-category-y="<%= category_on_tile.y %>">

            <%= image_tag category_on_tile.building_sprite, class: "house-tile", alt: category_on_tile.name %>

            <div class="house-name"> <%= category_on_tile.name %></div>

          </div>
          <% note = category_on_tile.notes[0] %>
          <div class="building-btn">
            <button type="button"
                    class="btn btn-danger"
                    data-bs-toggle="modal"
                    data-bs-target="#noteModal_<%= note.id %>">
                      <div> View the note  🗝️</div>
                    </button>
          </div>

      <% end %>

            <%= button_to category_path(category_on_tile),
            method: :delete,
            data: { turbo_confirm: "Are you sure you want to demolish this building?"},
            class: "btn btn-outline-danger btn-sm" do %>
              ❌
              <% end %>


    <% elsif tile[:buildable] %>
      <!-- Tile is buildable but empty: Show '+' build button -->
      <button type="button"
            class="btn btn-light btn-lg"
            data-bs-toggle="offcanvas"
            data-bs-target="#new-category-menu"
            data-action="click->tile#buildForm"
            data-tile-x-param="<%= x %>"
            data-tile-y-param="<%= y %>"
            title="Build here">
      🏗️
      </button>
    <% end %>
  </div>
</div>
