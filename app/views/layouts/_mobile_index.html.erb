<h2>This is mobile version</h2>

<div class="modal-body p-0">
  <div class="card border-0 shadow-sm p-3 style-postit-detail">
  <%@trash = current_user.categories.find_or_create_by!(name: "trash", x: @indexed_tiles.sample[:row], y:@indexed_tiles.sample[:column] , sprite_image: "trash.png")%>
    <%= form_with(model: [@trash, @note]) do |f| %>

      <%= f.hidden_field :hotspot_type, value: "street" %>

      <div class="mb-3">
        <%= f.label :title, class: "form-label fw-bold text-dark" %>
        <%= f.text_field :title,
                        class: "form-control",
                        placeholder: "Write a best-seller",
                        required: true,
                        autofocus: true %>
      </div>

      <div class="mb-3">
        <%= f.label :content, "Note Details", class: "form-label fw-bold text-dark" %>
        <%= f.text_area :content,
                        rows: 4,
                        class: "form-control",
                        placeholder: "Write your thoughts or tasks here...",
                        required: true %>
      </div>

      <div class="d-grid">
        <%= f.submit "Throw on the streets for now", class: "btn btn-dark fw-bold" %>
      </div>

    <% end %>
  </div>
</div>

  <% @trash_notes.each do |note|%>
    <div class="card shadow-sm border-0 my-3 style-postit-detail">
      <div class="card-body p-4">
        <h4 class="card-title fw-bold text-dark border-bottom pb-2 mb-3">
          <%= note.title %>
        </h4>
        <p class="card-text text-dark fs-5" style="white-space: pre-line;">
          <%= note.content %>
        </p>
      </div>
    </div>
  <% end %>
